<!DOCTYPE html>
<html lang="hi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ऑल इन वन प्रो - Nexa AI System</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background-color: #0f172a;
            color: #f8fafc;
            font-family: Arial, sans-serif;
            padding: 20px;
        }
        .container-custom {
            background-color: #1e293b;
            padding: 30px;
            border-radius: 12px;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5);
            max-width: 600px;
            margin: 0 auto 30px auto;
            text-align: center;
        }
        h1 {
            color: #38bdf8;
            margin-bottom: 10px;
            font-size: 2rem;
        }
        p {
            color: #94a3b8;
            margin-bottom: 20px;
        }
        .btn-custom {
            background-color: #0284c7;
            color: white;
            border: none;
            padding: 12px 24px;
            font-size: 1rem;
            border-radius: 8px;
            cursor: pointer;
            transition: background 0.3s ease;
        }
        .btn-custom:hover {
            background-color: #0369a1;
        }
        #output {
            margin-top: 20px;
            padding: 15px;
            background-color: #0f172a;
            border-radius: 8px;
            color: #38bdf8;
            display: none;
        }
        .card-custom {
            background-color: #1e293b;
            border: 1px solid #334155;
            color: #ffffff;
        }
        .form-label {
            color: #cbd5e1;
        }
    </style>
</head>
<body>

    <!-- A2A AI Section -->
    <div class="container-custom">
        <h1>Nexa AI System</h1>
        <p>A2A (Agent-to-Agent) Protocol Integration Panel</p>
        <button id="actionBtn" class="btn-custom">सिस्टम स्थिति जांचें</button>
        <div id="output"></div>
    </div>

    <!-- Pump Operator & Billing Section -->
    <div class="container my-4">
        <div class="card card-custom p-4 shadow-sm" id="pump-society-section">
            <h4 class="mb-3 text-info">पंप ऑपरेटर & लोक वितरक (सोसाइटी बिलिंग)</h4>
            <form id="pumpBillingForm">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label for="societyName" class="form-label">सोसाइटी / ग्राहक का नाम</label>
                        <input type="text" class="form-control" id="societyName" placeholder="उदा. आदर्श ग्रीन सोसाइटी" required>
                    </div>
                    <div class="col-md-6">
                        <label for="operatorName" class="form-label">पंप ऑपरेटर का नाम</label>
                        <input type="text" class="form-control" id="operatorName" placeholder="उदा. राम सिंह" required>
                    </div>
                    <div class="col-md-4">
                        <label for="readingUnits" class="form-label">कुल सप्लाई (लीटर/यूनिट)</label>
                        <input type="number" class="form-control" id="readingUnits" placeholder="0" required>
                    </div>
                    <div class="col-md-4">
                        <label for="ratePerUnit" class="form-label">दर (प्रति यूनिट)</label>
                        <input type="number" class="form-control" id="ratePerUnit" placeholder="0" required>
                    </div>
                    <div class="col-md-4 d-flex align-items-end">
                        <button type="submit" class="btn btn-info w-100">बिल जेनरेट करें</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- JavaScript Logic -->
    <script>
        document.getElementById('actionBtn').addEventListener('click', function() {
            const outputDiv = document.getElementById('output');
            outputDiv.style.display = 'block';
            outputDiv.innerHTML = '✨ Nexa AI एजेंट सफलतापूर्वक कनेक्ट हो गया है!';
        });

        document.getElementById('pumpBillingForm').addEventListener('submit', function(e) {
            e.preventDefault();
            const society = document.getElementById('societyName').value;
            const units = parseFloat(document.getElementById('readingUnits').value) || 0;
            const rate = parseFloat(document.getElementById('ratePerUnit').value) || 0;
            const total = units * rate;
            alert(`सोसाइटी: ${society}\nकुल बिल राशि: ₹${total}`);
        });
    </script>
</body>
</html>

