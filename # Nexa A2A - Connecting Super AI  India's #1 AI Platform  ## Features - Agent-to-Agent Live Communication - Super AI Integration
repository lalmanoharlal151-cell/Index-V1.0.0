<!DOCTYPE html>
<html lang="hi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nexa A2A - Super AI Live Communication</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
    <!-- Header / Navbar -->
    <header style="display: flex; justify-content: space-between; align-items: center; padding: 15px 30px; border-bottom: 1px solid rgba(255,255,255,0.1);">
        <div class="logo" style="font-size: 22px; font-weight: bold; color: var(--neon-blue);">
            NEXA <span style="color: var(--neon-purple);">>A2A</span>
        </div>
        <div class="status-indicator" style="display: flex; align-items: center; gap: 8px; font-size: 14px; color: var(--text-muted);">
            <span style="width: 10px; height: 10px; background-color: #00ff66; border-radius: 50%; box-shadow: 0 0 8px #00ff66;"></span>
            Agents Live & Connected
        </div>
    </header>
<main class="dashboard-container">

    <!-- Control Panel Section -->
    <section class="control-panel">
        <h3>Agent Command Center</h3>
        <p>Manage and monitor real-time Agent-to-Agent communication protocols.</p>
        <div class="button-group">
            <button id="start-btn" class="neon-btn">Initialize Agents</button>
            <button id="reset-btn" class="secondary-btn">Reset Protocol</button>
        </div>
    </section>

    <!-- Live Communication Grid -->
    <section class="chat-grid">
        <!-- Agent 1 Card -->
        <div class="agent-card">
            <h4>Agent Alpha (Primary AI)</h4>
            <div class="chat-box" id="agent-1-output">
                <p class="muted">Waiting for synchronization...</p>
            </div>
        </div>

        <!-- Agent 2 Card -->
        <div class="agent-card">
            <h4>Agent Beta (Integration Node)</h4>
:root {
    --neon-purple: #a855f7;
    --bg-color: #0f172a;
    --card-bg: #1e293b;
    --text-color: #f8fafc;
}

body {
    background-color: var(--bg-color);
    color: var(--text-color);
    font-family: Arial, sans-serif;
    margin: 0;
    padding: 20px;
}

.dashboard-container {
    max-width: 1000px;
    margin: auto;
}

.control-panel, .chat-grid {
    background: var(--card-bg);
    padding: 20px;
    border-radius: 12px;
    margin-bottom: 20px;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.3);
}

.button-group {
    display: flex;
    gap: 10px;
    margin-top: 15px;
}

.neon-btn {
    background: var(--neon-purple);
    color: white;
    border: none;
    padding: 10px 20px;
    border-radius: 8px;
    cursor: pointer;
    font-weight: bold;
    box-shadow: 0 0 10px rgba(168, 85, 247, 0.4);
}

.secondary-btn {
    background: transparent;
    color: var(--text-color);
    border: 1px solid #475569;
    padding: 10px 20px;
    border-radius: 8px;
    cursor: pointer;
}

.agent-card {
    background: #0f172a;
    padding: 15px;
    border-radius: 8px;
    margin-top: 15px;
    border: 1px solid #334155;
}

.muted {
    color: #94a3b8;
}
<script>
    const startBtn = document.getElementById('start-btn');
    const resetBtn = document.getElementById('reset-btn');
    const agent1Output = document.getElementById('agent-1-output');

    startBtn.addEventListener('click', () => {
        agent1Output.innerHTML = '<p style="color: #a855f7;">Initializing Agent-to-Agent handshake...</p>';
        setTimeout(() => {
            agent1Output.innerHTML += '<p style="color: #22c55e;">✔ Connection established with Agent Beta (Integration Node). Super AI protocol active.</p>';
        }, 1500);
    });

    resetBtn.addEventListener('click', () => {
        agent1Output.innerHTML = '<p class="muted">Waiting for synchronization...</p>';
    });
</script>
<!-- Agent 2 Card -->
<div class="agent-card">
    <h4>Agent Beta (Integration Node)</h4>
    <div class="chat-box" id="agent-2-output">
        <p class="muted">Awaiting protocol handshake...</p>
    </div>
</div>
<script>
    const startBtn = document.getElementById('start-btn');
    const resetBtn = document.getElementById('reset-btn');
    const agent1Output = document.getElementById('agent-1-output');
    const agent2Output = document.getElementById('agent-2-output');

    startBtn.addEventListener('click', () => {
        agent1Output.innerHTML = '<p style="color: #a855f7;">Initializing Agent-to-Agent handshake...</p>';
        agent2Output.innerHTML = '<p class="muted">Listening for incoming node...</p>';

        setTimeout(() => {
            agent1Output.innerHTML += '<p style="color: #22c55e;">✔ Handshake successful with Agent Beta.</p>';
            agent2Output.innerHTML = '<p style="color: #22c55e;">✔ Connected to Agent Alpha. Super AI active.</p>';
        }, 1500);
    });

    resetBtn.addEventListener('click', () => {
        agent1Output.innerHTML = '<p class="muted">Waiting for synchronization...</p>';
        agent2Output.innerHTML = '<p class="muted">Awaiting protocol handshake...</p>';
    });
</script>
