<!DOCTYPE html>
<html lang="hi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>A2A Nexa - AI Agent Platform</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-color: #0f172a;
            color: #f8fafc;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        header {
            background-color: #1e293b;
            padding: 1rem 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid #334155;
        }

        .logo {
            font-size: 1.5rem;
            font-weight: bold;
            color: #38bdf8;
        }

        .status-badge {
            background-color: #22c55e;
            color: #000;
            padding: 0.25rem 0.75rem;
            border-radius: 9999px;
            font-size: 0.85rem;
            font-weight: 600;
        }

        main {
            flex: 1;
            padding: 2rem;
            max-width: 1000px;
            margin: 0 auto;
            width: 100%;
        }

        .hero {
            text-align: center;
            margin-bottom: 2.5rem;
        }

        .hero h1 {
            font-size: 2.5rem;
            margin-bottom: 0.5rem;
            color: #f1f5f9;
        }

        .hero p {
            color: #94a3b8;
        }

        .card-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 1.5rem;
            margin-bottom: 2rem;
        }

        .card {
            background-color: #1e293b;
            border: 1px solid #334155;
            border-radius: 8px;
            padding: 1.5rem;
        }

        .card h3 {
            color: #38bdf8;
            margin-bottom: 0.5rem;
        }

        .card p {
            color: #cbd5e1;
            font-size: 0.95rem;
        }

        .console-section {
            background-color: #1e293b;
            border: 1px solid #334155;
            border-radius: 8px;
            padding: 1.5rem;
        }

        .console-header {
            margin-bottom: 1rem;
            color: #f1f5f9;
        }

        .input-group {
            display: flex;
            gap: 0.5rem;
        }

        input[type="text"] {
            flex: 1;
            padding: 0.75rem;
            border-radius: 6px;
            border: 1px solid #334155;
            background-color: #0f172a;
            color: #fff;
            outline: none;
        }

        input[type="text"]:focus {
            border-color: #38bdf8;
        }

        button {
            background-color: #0284c7;
            color: white;
            border: none;
            padding: 0.75rem 1.5rem;
            border-radius: 6px;
            cursor: pointer;
            font-weight: 600;
            transition: background-color 0.2s;
        }

        button:hover {
            background-color: #0369a1;
        }

        #output {
            margin-top: 1rem;
            padding: 1rem;
            background-color: #0f172a;
            border-radius: 6px;
            border: 1px solid #334155;
            min-height: 80px;
            font-family: monospace;
            color: #38bdf8;
        }

        footer {
            text-align: center;
            padding: 1rem;
            background-color: #1e293b;
            color: #64748b;
            font-size: 0.85rem;
            border-top: 1px solid #334155;
        }
    </style>
</head>
<body>

    <header>
        <div class="logo">A2A Nexa</div>
        <div class="status-badge">System Ready</div>
    </header>

    <main>
        <section class="hero">
            <h1>A2A Nexa Interface</h1>
            <p>Agent-to-Agent Communication & Operations Console</p>
        </section>

        <section class="card-grid">
            <div class="card">
                <h3>Agent Network</h3>
                <p>स्वचालित एजेंट्स का एक्टिव नेटवर्क और कम्युनिकेशन प्रोटोकॉल।</p>
            </div>
            <div class="card">
                <h3>Workflow Automation</h3>
                <p>प्रॉम्प्ट्स और ट्रिगर्स के ज़रिए रियल-टाइम प्रोसेस मैनेजमेंट।</p>
            </div>
            <div class="card">
                <h3>API & Webhooks</h3>
                <p>एक्सटर्नल सर्विसेज और डेटा ट्रांसफर के लिए सुरक्षित कनेक्शन।</p>
            </div>
        </section>

        <section class="console-section">
            <h2 class="console-header">Agent Console</h2>
            <div class="input-group">
                <input type="text" id="userInput" placeholder="कमांड या संदेश दर्ज करें...">
                <button onclick="processCommand()">Send Command</button>
            </div>
            <div id="output">System Initialized. Awaiting input...</div>
        </section>
    </main>

    <footer>
        &copy; 2026 A2A Nexa Project. All rights reserved.
    </footer>

    <script>
        function processCommand() {
            const inputField = document.getElementById('userInput');
            const outputDiv = document.getElementById('output');
            const userText = inputField.value.trim();

            if (userText === "") {
                outputDiv.innerText = "कृपया कोई कमांड या मैसेज टाइप करें।";
                return;
            }

            outputDiv.innerText = "Processing command: '" + userText + "'...";

            setTimeout(() => {
                outputDiv.innerText = "[A2A Response]: Command '" + userText + "' successfully received and executed.";
                inputField.value = "";
            }, 1000);
        }
    </script>

</body>
</html>
