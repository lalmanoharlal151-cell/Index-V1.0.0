const NEWS_BACKEND_URL = "https://your-render-app.onrender.com/api/nature-news";

// 2. Gemini Multi-Key Rotation (यदि AI से सीधे अजीब-गरीब समाचार जनरेट कराने हों)
const API_KEYS = [
    "YOUR_GEMINI_API_KEY_1",
    "YOUR_GEMINI_API_KEY_2",
    "YOUR_GEMINI_API_KEY_3"
];

let currentKeyIndex = 0;

function rotateKey() {
    currentKeyIndex = (currentKeyIndex + 1) % API_KEYS.length;
    console.warn(`[Nature News] Switched API Key Index to: ${currentKeyIndex}`);
}

