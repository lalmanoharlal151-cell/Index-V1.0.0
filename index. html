        .container, .card {
            background-color: #111827;
            border: 1px solid #1f2937;
            border-radius: 12px;
            padding: 25px;
            margin-bottom: 20px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.3);
        }
        h1, h4 {
            color: #38bdf8;
        }
        .form-label {
            color: #d1d5db;
        }
        .form-control {
            background-color: #1f2937;
            border: 1px solid #374151;
            color: #white;
        }
        .form-control:focus {
            background-color: #1f2937;
            color: #white;
            border-color: #38bdf8;
            box-shadow: none;
        }
        button {
            background-color: #2563eb;
            color: white;
            border: none;
            padding: 12px 24px;
            font-size: 1rem;
            border-radius: 8px;
            cursor: pointer;
            transition: background 0.3s ease;
        }
        button:hover {
            background-color: #1d4ed8;
        }
        #output {
            margin-top: 20px;
            padding: 15px;
            background-color: #0f172a;
            border-radius: 8px;
            color: #38bdf8;
            display: none;
        }
    </style>
</head>
<body>

    <!-- मुख्य सिस्टम पैनल -->
    <div class="container">
        <h1>Nexa AI System</h1>
        <p>A2A (Agent-to-Agent) Protocol Integration Panel</p>
        <button id="actionBtn">सिस्टम स्थिति जांचें</button>
        <div id="output"></div>
    </div>

    <!-- पंप ऑपरेटर & सोसाइटी बिलिंग सेक्शन -->
    <div class="card my-4 p-4 shadow-sm" id="pump-society-section">
        <h4 class="mb-3">⚡ पंप ऑपरेटर & लोक वितरक (सोसाइटी बिलिंग)</h4>
        <form id="pumpBillingForm">
            <div class="row g-3">
                <div class="col-md-6">
                    <label for="societyName" class="form-label">सोसाइटी / ग्राहक का नाम</label>
                    <input type="text" class="form-control" id="societyName" placeholder="नाम दर्ज करें">
                </div>
                <div class="col-md-6">
                    <label for="operatorName" class="form-label">पंप ऑपरेटर का नाम</label>
                    <input type="text" class="form-control" id="operatorName" placeholder="ऑपरेटर का नाम">
                </div>
                <div class="col-md-4">
                    <label for="readingUnits" class="form-label">कुल सप्लाई (लीटर/यूनिट)</label>
                    <input type="number" class="form-control" id="readingUnits" placeholder="0">
                </div>
                <div class="col-md-4">
                    <label for="ratePerUnit" class="form-label">दर (रु प्रति यूनिट)</label>
                    <input type="number" class="form-control" id="ratePerUnit" placeholder="0.00">
                </div>
            </div>
        </form>
    </div>

    <script>
        // JavaScript Logic
        document.getElementById('actionBtn').addEventListener('click', () => {
            const outputDiv = document.getElementById('output');
            outputDiv.style.display = 'block';
            outputDiv.innerHTML = '⚡ Nexa AI एजेंट सफलतापूर्वक कनेक्ट हो गया है।';
        });
    </script>

</body>
</html>







